# Vision providers (one key per provider, see PLAN ADR-003)
GEMINI_API_KEY=
GROQ_API_KEY=
VISION_PROVIDER=gemini          # primary: gemini | groq
VISION_FALLBACK_PROVIDER=groq   # used only after repeated 429s
# strict | lenient (PLAN ADR-014)
ID_CHECKSUM_MODE=strict
MAX_CONCURRENCY=2
DATABASE_URL=postgresql+psycopg://hakaton:hakaton@localhost:5432/hakaton
STORAGE_DIR=./data/storage

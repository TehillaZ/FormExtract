# Vision providers (one key per provider, see PLAN ADR-003)
GEMINI_API_KEY=
GROQ_API_KEY=
VISION_PROVIDER=gemini          # primary: gemini | groq
VISION_FALLBACK_PROVIDER=groq   # used only after repeated 429s
# strict | lenient (PLAN ADR-014)
ID_CHECKSUM_MODE=strict
MAX_CONCURRENCY=2
DATABASE_URL=postgresql+psycopg://hakaton:hakaton@localhost:5432/hakaton
STORAGE_DIR=./data/storage
# Gemini free tier: 20 requests per DAY per model. Models tried in order when one is out of quota (JSON list).
# 2.5-flash is the best measured and fast; 3.5-flash takes about 100 s a page, so it goes last
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=["gemini-3.1-flash-lite","gemini-3.5-flash-lite","gemini-3.5-flash"]
